# Keeps the Docker build context (repo root -- see apps/site/Dockerfile) small
# and makes sure the image always gets a fresh, container-native `pnpm install`
# rather than whatever's in each dev's local node_modules/.next/dist.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
.turbo
**/.turbo
.git
.github
deploy
coverage
**/coverage
*.tsbuildinfo
.superpowers

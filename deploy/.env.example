# Copy this file to `.env` in the same directory (`deploy/.env`), fill in
# DOMAIN, and run `./setup.sh`. Every other key below is generated for you
# by setup.sh on first run if left blank -- you don't need to invent values.
# `.env` is gitignored (`.env*` / `!.env.example` at the repo root); never
# commit it, and never share its contents -- it holds this install's private
# keys and passwords.

# --- You fill this in ---

# Apex domain this instance is reachable at. Must already have two DNS A (or
# AAAA) records pointing at this VPS's public IP before running setup.sh:
# the apex (DOMAIN) and `pds.` + DOMAIN. setup.sh's preflight checks this
# and tells you exactly what to create if it isn't right yet.
DOMAIN=example.com

# A real email address you control. Used only when setup.sh creates the
# owner account on the PDS (com.atproto.server.createAccount) -- the app
# itself never reads this var. Not shared with anyone but your own PDS.
OWNER_EMAIL=you@example.com

# --- setup.sh generates these (leave blank) ---

# Bluesky PDS admin password. Gates the PDS's own admin API (invite-code and
# account creation) -- generate-don't-share.
PDS_ADMIN_PASSWORD=

# Signing secret for the PDS's internal service JWTs (openssl rand --hex 16,
# matching the reference PDS's own installer.sh). generate-don't-share.
PDS_JWT_SECRET=

# This instance's PLC rotation ("signing") key -- a secp256k1 private key as
# 32 bytes of hex, generated the same way the reference PDS's installer.sh
# does (`openssl ecparam --name secp256k1 ...`). This is the key the PDS
# itself holds and uses day-to-day; it is NOT the offline recovery key (see
# `recovery-key-KEEP-OFFLINE.txt`, written during the setup.sh recovery-key
# ceremony) -- that one is a *higher-priority* rotation key kept outside this
# server entirely, precisely so it can override this one if this server is
# ever compromised. generate-don't-share.
PDS_ROTATION_KEY=

# This instance owner's ATProto DID (did:plc:...), assigned when setup.sh
# creates the owner account on the PDS above. Only this DID is ever granted
# admin/publish access in the app (see apps/site/lib/session.ts). Not a
# secret, but not yours to set by hand -- setup.sh writes it.
OWNER_DID=

# This instance owner's PDS account password, generated by setup.sh at
# account-creation time. You need this once, to complete the first OAuth
# sign-in in a browser (the ATProto authorization screen is served by the
# PDS itself, not this app) -- setup.sh prints it once at the end of the
# run. The app itself never reads this var. generate-don't-share.
OWNER_PASSWORD=

# Signs the admin dashboard's session cookie (iron-session). 32 bytes of hex
# (openssl rand -hex 32). generate-don't-share.
SESSION_SECRET=

# This instance's confidential OAuth client signing key: an ES256 private
# JWK, JSON-serialized on one line, WITH a "kid" (required -- the OAuth
# client library rejects a keyset entry with no kid). Generated inside the
# app container so it can use `@atproto/jwk-jose`'s `JoseKey.generate`
# (already a production dependency -- no extra install needed on the VPS).
# Per-install; never shared across deployments. generate-don't-share.
OAUTH_JWK=

# --- Optional ---

# Absolute in-container path where nightly CAR + blob backups are written
# (bind-mounted to ./backups on the host by docker-compose.yml). Leave unset
# to disable backups entirely -- that's a supported default, not an error.
BACKUP_DIR=/backups
